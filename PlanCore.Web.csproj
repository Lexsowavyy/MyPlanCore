<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>PlanCore.Web</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

        <!-- Suppress vulnerability warnings for System.Security.Cryptography.Xml (kept in sync with MAUI app) -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CloudinaryDotNet" Version="1.26.2" />
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
        <PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.8.6" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Reuse the exact same Models, Data and Services source files so function logic is unchanged. -->
    <ItemGroup>
        <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Models\bin\**;..\Models\obj\**" />
        <Compile Include="..\Data\**\*.cs" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Data\bin\**;..\Data\obj\**" />
        <Compile Include="..\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" Exclude="..\Services\bin\**;..\Services\obj\**;**\AuthService.cs" />
    </ItemGroup>

    <!-- Shared static assets (app.css lives in this project's wwwroot so the
         static web asset manifest resolves it; linking it again caused a duplicate-key build error) -->
    <ItemGroup>
        <Content Include="..\wwwroot\lib\**" Link="wwwroot\lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Shared .env config (contains DB / encryption / PayMongo / SMTP settings) -->
    <ItemGroup>
        <None Include="..\.env" Link=".env" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- One-time local-database migration payload. Only present until the first
         deploy runs the import (the app renames it to import_data.done.json). -->
    <ItemGroup Condition="Exists('import_data.json')">
        <Content Update="import_data.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>