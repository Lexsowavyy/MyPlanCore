    private List<NavItem> FilterNavItemsBySubscription(List<NavItem> items)
    {
        var filtered = new List<NavItem>();
        foreach (var item in items)
        {
            if (item.Children != null && item.Children.Count > 0)
            {
                var filteredChildren = FilterNavItemsBySubscription(item.Children);
                if (filteredChildren.Count > 0)
                    filtered.Add(new NavItem { Icon = item.Icon, Label = item.Label, Url = item.Url, Children = filteredChildren });
            }
            else if (string.IsNullOrEmpty(item.Url))
            {
                filtered.Add(item);
            }
            else
            {
                var relativePath = item.Url.TrimStart('/').ToLowerInvariant();
                if (PlanCoreMAUI.Services.SubscriptionService.CheckRouteAccess(relativePath))
                    filtered.Add(item);
            }
        }
        return filtered;
    }
