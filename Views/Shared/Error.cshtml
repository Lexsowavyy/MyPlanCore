@{
    ViewData["Title"] = "Error";
}
<div style="min-height: 100vh; display: flex; justify-content: center; align-items: center; background: #f4f6fb; font-family: 'Poppins', sans-serif;">
    <div style="text-align: center; background: #fff; border-radius: 16px; padding: 48px 56px; max-width: 460px; box-shadow: 0 10px 40px rgba(0,0,0,0.1); border: 1px solid #e2e8f0;">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: #fef2f2; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
            <i class="fas fa-exclamation-triangle" style="color: #ef4444; font-size: 28px;"></i>
        </div>
        <h1 style="margin: 0 0 8px; font-size: 22px; font-weight: 700; color: #0f172a;">Something went wrong</h1>
        <p style="margin: 0 0 24px; font-size: 14px; color: #64748b;">An unexpected error occurred while processing your request. Please try again later.</p>
        <a href="/" style="display: inline-block; padding: 12px 28px; background: #dc2626; color: #fff; border-radius: 10px; font-size: 14px; font-weight: 600; text-decoration: none;">Back to Home</a>
    </div>
</div>