@model PlanCore.Web.ViewModels.MfaViewModel
@{
    Layout = "_LoginLayout";
}
<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; box-sizing: border-box;">
    <div style="background: #ffffff; border-radius: 24px; padding: 52px 72px; width: 100%; max-width: 90vw; box-shadow: 0 20px 60px rgba(0,0,0,0.5); text-align: center; font-family: 'Poppins', sans-serif;">
        <div style="text-align: center; margin-bottom: 28px;">
            <img src="~/images/logo.png" alt="PlanCore Logo" style="width: 140px; height: auto;" />
        </div>

        <h2 style="margin: 0 0 12px; font-size: 1.25rem; font-weight: 700; color: #0f172a;">
            <i class="fas fa-shield-alt" style="color: #059669; margin-right: 8px;"></i> Two-Factor Verification
        </h2>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem;">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.DevCode))
        {
            <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #92400e; font-size: 0.75rem;">
                <i class="fas fa-flask" style="margin-right: 6px;"></i> Dev mode (email not configured): your code is <strong style="letter-spacing: 3px;">@Model.DevCode</strong>
            </div>
        }

        <form method="post" action="/Home/Mfa">
            <div style="margin-bottom: 14px; text-align: left;">
                <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                    <i class="fas fa-envelope" style="color: #0f172a; margin-right: 5px;"></i> Verification Code
                </label>
                <div style="font-size: 0.7rem; color: #64748b; margin-bottom: 8px; text-align: center;">
                    A 6-digit code was sent to your registered email. Check your inbox (and spam folder).
                </div>
                <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; background: #f8fafc;">
                    <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                        <i class="fas fa-shield-alt" style="font-size: 0.82rem;"></i>
                    </span>
                    <input type="text" name="code" value="@Model.Code" style="border: none; padding: 11px 10px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif; letter-spacing: 8px; text-align: center;" placeholder="_ _ _ _ _ _" maxlength="6" />
                </div>
            </div>

            <button type="submit" style="width: 100%; padding: 11px; font-size: 0.85rem; font-weight: 600; color: #ffffff; background: linear-gradient(135deg, #059669 0%, #10b981 100%); border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 20px rgba(5,150,105,0.45);">
                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> Verify Code
            </button>

            <div style="margin-top: 10px; text-align: center;">
                <a href="/" style="color: #64748b; text-decoration: none; font-size: 0.75rem;">
                    <i class="fas fa-arrow-left" style="margin-right: 4px;"></i> Back to login
                </a>
            </div>
        </form>
    </div>
</div>