@model PlanCore.Web.ViewModels.LoginViewModel
@{
    Layout = "_LoginLayout";
    bool isUnderMaintenance = (bool)(ViewData["MaintenanceMode"] ?? false);
}
<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; box-sizing: border-box;">
    <div style="background: #ffffff; border-radius: 24px; padding: 32px 120px; width: 100%; max-width: 1200px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); text-align: center; font-family: 'Poppins', sans-serif;">
        <div style="text-align: center; margin-bottom: 16px;">
            <img src="~/images/logo.png" alt="PlanCore Logo" style="width: 200px; height: auto;" />
        </div>

        @if (isUnderMaintenance)
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem; text-align: center;">
                <i class="fas fa-tools" style="margin-right: 6px;"></i> System is under maintenance.
            </div>
        }
        @if (Model.IsAccountLocked)
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem; text-align: center;">
                <i class="fas fa-lock" style="margin-right: 6px;"></i> Account locked. Try again in <strong>@Model.LockoutMinutesRemaining minute@(Model.LockoutMinutesRemaining != 1 ? "s" : "")</strong>.
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem;">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.WarningMessage))
        {
            <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #92400e; font-size: 0.75rem; text-align: center;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 6px;"></i> @Model.WarningMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ResetNotifyMessage))
        {
            <div style="background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #166534; font-size: 0.75rem; text-align: center;">
                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> @(Html.Raw(Model.ResetNotifyMessage))
            </div>
        }
        @if (Model.RemainingAttempts > 0 && Model.RemainingAttempts < 3 && !string.IsNullOrEmpty(Model.Email))
        {
            <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 8px 14px; margin-bottom: 12px; color: #92400e; font-size: 0.7rem; text-align: center;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 4px;"></i> @Model.RemainingAttempts attempt(s) remaining before lockout.
            </div>
        }

        <form method="post" action="/Home/SignIn">
            <div style="margin-bottom: 14px; text-align: left;">
                <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                    <i class="fas fa-envelope" style="color: #0f172a; margin-right: 5px;"></i> Email
                </label>
                <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; transition: all 0.3s; background: #f8fafc;">
                    <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                        <i class="fas fa-at" style="font-size: 0.82rem;"></i>
                    </span>
                    <input type="email" name="email" style="border: none; padding: 16px 24px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif;" placeholder="Enter your email" value="@Model.Email" />
                </div>
            </div>

            <div style="margin-bottom: 14px; text-align: left;">
                <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                    <i class="fas fa-lock" style="color: #0f172a; margin-right: 5px;"></i> Password
                </label>
                <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; transition: all 0.3s; background: #f8fafc;">
                    <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                        <i class="fas fa-key" style="font-size: 0.82rem;"></i>
                    </span>
                    <input type="password" name="password" style="border: none; padding: 16px 24px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif;" placeholder="Enter your password" value="@Model.Password" />
                </div>
            </div>

            <div style="display: flex; align-items: center; margin: 6px 0 16px;">
                <input type="checkbox" id="rememberMe" name="rememberMe" value="true" style="width: 14px; height: 14px; margin-right: 7px; cursor: pointer; accent-color: #0f172a;" checked="@(Model.RememberMe ? "checked" : null)" />
                <label for="rememberMe" style="font-size: 0.75rem; color: #64748b; cursor: pointer; font-weight: 500; margin: 0;">
                    <i class="fas fa-clock" style="color: #0f172a; margin-right: 4px;"></i> Remember me
                </label>
            </div>

            <div style="display: flex; justify-content: center; margin-bottom: 16px;">
                <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
            </div>

            <button type="submit" style="width: 100%; padding: 11px; font-size: 0.85rem; font-weight: 600; color: #ffffff; background: linear-gradient(135deg, #0f172a 0%, #0f2456 50%, #1e3a6e 100%); border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 20px rgba(15,23,42,0.45);">
                <i class="fas fa-sign-in-alt" style="margin-right: 6px;"></i> Sign In
            </button>

            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px solid #f1f5f9; text-align: center; display: flex; justify-content: center; gap: 24px;">
                <a href="javascript:void(0)" onclick="openForgotModal()" style="color: #0f172a; text-decoration: none; font-size: 0.75rem; font-weight: 500;">
                    <i class="fas fa-question-circle" style="margin-right: 4px;"></i> Forgot password?
                </a>
            </div>
        </form>
    </div>
</div>

<div id="forgotModal" style="display: @(Model.ShowForgot ? "flex" : "none"); position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; font-family: 'Poppins', sans-serif;">
    <div style="background: #fff; border-radius: 16px; width: 100%; max-width: 420px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; border-radius: 16px 16px 0 0;">
            <h3 style="margin: 0; font-size: 18px; font-weight: 600; color: #0f172a;"><i class="fas fa-key" style="margin-right: 8px; color: #f59e0b;"></i> Request Password Reset</h3>
            <button type="button" style="background: none; border: none; font-size: 18px; color: #94a3b8; cursor: pointer; padding: 4px 8px; border-radius: 6px;" onclick="document.getElementById('forgotModal').style.display='none'"><i class="fas fa-times"></i></button>
        </div>
        <form method="post" action="/Home/Forgot">
            <div style="padding: 24px;">
                @if (!string.IsNullOrEmpty(Model.ForgotSuccessMessage))
                {
                    <div style="background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #166534; font-size: 0.75rem; text-align: center;">@Model.ForgotSuccessMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.ForgotErrorMessage))
                {
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem;">@Model.ForgotErrorMessage</div>
                }
                <div style="margin-bottom: 14px; text-align: left;">
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;"><i class="fas fa-envelope" style="margin-right: 4px;"></i> Email</label>
                    <input type="email" name="forgotEmail" style="width: 100%; padding: 10px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.82rem; box-sizing: border-box; font-family: 'Poppins', sans-serif;" value="@Model.ForgotEmail" />
                    <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 6px;">Your request will be sent to the security team for approval.</div>
                </div>
                <div style="display: flex; justify-content: center; margin-bottom: 8px;">
                    <div id="forgot-recaptcha"></div>
                </div>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; padding: 20px 24px; border-top: 1px solid #e2e8f0; background: #f8fafc; border-radius: 0 0 16px 16px;">
                <button type="button" style="height: 42px; padding: 0 24px; border: 1.5px solid #cbd5e1; border-radius: 8px; background: #fff; color: #475569; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Poppins', sans-serif;" onclick="document.getElementById('forgotModal').style.display='none'">Cancel</button>
                <button type="submit" style="height: 42px; padding: 0 24px; border: none; border-radius: 8px; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; font-family: 'Poppins', sans-serif; background: #f59e0b;">
                    <i class="fas fa-paper-plane" style="margin-right: 6px;"></i> Submit Request
                </button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script>
    var forgotWidgetId = null;
    var recaptchaSiteKey = '@Model.RecaptchaSiteKey';
    function openForgotModal() {
        document.getElementById('forgotModal').style.display = 'flex';
        renderForgotCaptcha();
    }
    function renderForgotCaptcha() {
        if (typeof grecaptcha === 'undefined' || typeof grecaptcha.render !== 'function') {
            setTimeout(renderForgotCaptcha, 200);
            return;
        }
        if (forgotWidgetId === null) {
            forgotWidgetId = grecaptcha.render('forgot-recaptcha', { sitekey: recaptchaSiteKey });
        }
    }
    @if (Model.ShowForgot)
    {
        <text>document.addEventListener('DOMContentLoaded', openForgotModal);</text>
    }
</script>
}