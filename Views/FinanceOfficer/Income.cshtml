<script>
    (function () {
        ['addIncomeForm', 'editIncomeForm'].forEach(function (formId) {
            var form = document.getElementById(formId);
            if (!form) return;
            var otherCb = form.querySelector('input[name="cats"][value="Other"]');
            var otherInput = form.querySelector('input.other-specify');
            if (!otherCb || !otherInput) return;
            otherCb.addEventListener('change', function () {
                otherInput.style.display = otherCb.checked ? '' : 'none';
            });
        });
    })();
</script>