@functions {
    string GetStatusClass(string? status)
    {
        return status switch
        {
            "Pending" => "badge-yellow",
            "Approved" => "badge-green",
            "Rejected" => "badge-red",
            _ => "badge-yellow"
        };
    }
}
<script>
    (function () {
        var form = document.getElementById('addExpenseForm');
        if (!form) return;
        var otherCb = form.querySelector('input[name="cats"][value="Other"]');
        var otherInput = form.querySelector('input.other-specify');
        if (!otherCb || !otherInput) return;
        function sync() { otherInput.style.display = otherCb.checked ? '' : 'none'; }
        otherCb.addEventListener('change', sync);
        sync();
    })();
</script>