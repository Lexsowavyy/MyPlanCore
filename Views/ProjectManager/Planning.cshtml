@functions {
    string FormatDateTime(DateTime? date)
    {
        return date?.ToString("MMM dd, yyyy h:mm tt") ?? "-";
    }

    string GetStatusClass(string? status)
    {
        return status switch
        {
            "In Progress" => "badge-blue",
            "On Track" => "badge-green",
            "Delayed" => "badge-red",
            "Completed" => "badge-teal",
            "Planning" => "badge-orange",
            _ => "badge-yellow"
        };
    }
}

<script>
    (function () {
        function manilaTime() {
            var s = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit', hour12: false
            }).format(new Date());
            return s.length === 5 ? s : '00:00';
        }
        function normalize(el) {
            if (!el || !el.value) return;
            if (el.value.length >= 16 && el.value.slice(11, 16) === '00:00') {
                el.value = el.value.slice(0, 11) + manilaTime();
            }
        }
        ['np-startDate', 'np-dueDate', 'ep-startDate', 'ep-dueDate'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('change', function () { normalize(el); });
            normalize(el);
        });
    })();
</script>