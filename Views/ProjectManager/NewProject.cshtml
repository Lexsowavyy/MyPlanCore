@model PlanCore.Web.ViewModels.PMNewProjectViewModel
@using PlanCore.Web.ViewModels
<div class="popup-overlay">
    <div class="form-popup">
        <div class="form-popup-header">
            <div>
                <h2 class="form-popup-title"><i class="fas fa-plus-circle"></i> New Project</h2>
                <p class="form-popup-subtitle">Create a new construction project</p>
            </div>
            <a class="form-popup-close" href="/projectmanager/planning">
                <i class="fas fa-times"></i>
            </a>
        </div>

        <form method="post" action="/projectmanager/planning/new">
            <div class="form-popup-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
                    </div>
                }
                <div class="form-group">
                    <label><i class="fas fa-building"></i> Project Name *</label>
                    <input type="text" name="name" class="form-input" placeholder="Enter project name" value="@Model.Name" />
                </div>
                <div class="form-group">
                    <label><i class="fas fa-map-marker-alt"></i> Location *</label>
                    <input type="text" name="location" class="form-input" placeholder="Enter project location" value="@Model.Location" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label><i class="fas fa-calendar-alt"></i> Start Date &amp; Time *</label>
                        <input type="datetime-local" name="startDate" class="form-input" value="@Model.StartDate" />
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-calendar-check"></i> Due Date &amp; Time *</label>
                        <input type="datetime-local" name="dueDate" class="form-input" value="@Model.DueDate" />
                    </div>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-info-circle"></i> Status</label>
                    <select name="status" class="form-input">
                        <option value="Planning" selected="@(Model.Status == "Planning" ? "selected" : null)">Planning</option>
                        <option value="In Progress" selected="@(Model.Status == "In Progress" ? "selected" : null)">In Progress</option>
                        <option value="On Track" selected="@(Model.Status == "On Track" ? "selected" : null)">On Track</option>
                        <option value="Delayed" selected="@(Model.Status == "Delayed" ? "selected" : null)">Delayed</option>
                        <option value="On Hold" selected="@(Model.Status == "On Hold" ? "selected" : null)">On Hold</option>
                    </select>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-align-left"></i> Description</label>
                    <textarea name="description" class="form-input form-textarea" rows="4" placeholder="Enter project description">@Model.Description</textarea>
                </div>
            </div>

            <div class="form-popup-footer">
                <a class="btn-cancel" href="/projectmanager/planning">
                    <i class="fas fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn-create">
                    <i class="fas fa-check"></i>
                    <span>Create Project</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        function manilaTime() {
            var s = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Asia/Manila', hour: '2-digit', minute: '2-digit', hour12: false
            }).format(new Date());
            return s.length === 5 ? s : '00:00';
        }
        function normalize(el) {
            if (!el || !el.value) return;
            if (el.value.length >= 16 && el.value.slice(11, 16) === '00:00') {
                el.value = el.value.slice(0, 11) + manilaTime();
            }
        }
        document.querySelectorAll('input[type="datetime-local"]').forEach(function (el) {
            el.addEventListener('change', function () { normalize(el); });
            normalize(el);
        });
    })();
</script>

<style>
    .popup-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .form-popup {
        background: #fff;
        border-radius: 16px;
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        margin: 20px;
    }

    .form-popup-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 16px 16px 0 0;
        position: sticky;
        top: 0;
    }
    .form-popup-title {
        margin: 0 0 4px;
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .form-popup-title i { color: #3b82f6; }
    .form-popup-subtitle {
        margin: 0;
        font-size: 13px;
        color: #64748b;
    }
    .form-popup-close {
        background: none;
        border: none;
        font-size: 18px;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        margin-top: 4px;
        text-decoration: none;
    }
    .form-popup-close:hover { background: #fee2e2; color: #ef4444; }

    .form-popup-body { padding: 24px; }

    .alert {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 18px;
    }
    .alert-error  { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; }
    .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; }

    .form-group { margin-bottom: 18px; }
    .form-group:last-child { margin-bottom: 0; }
    .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }
    .form-group label i { margin-right: 8px; color: #64748b; }

    .form-input {
        width: 100%;
        height: 44px;
        padding: 0 14px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        color: #1e293b;
        background: #fff;
        font-family: 'Poppins', sans-serif;
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-input:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
    }
    .form-input:disabled { background: #f8fafc; opacity: 0.7; cursor: not-allowed; }
    .form-textarea { height: auto; padding: 12px 14px; resize: vertical; }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-popup-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding: 20px 24px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 0 0 16px 16px;
        position: sticky;
        bottom: 0;
    }
    .btn-cancel {
        height: 44px;
        padding: 0 28px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #475569;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        box-sizing: border-box;
        transition: background 0.2s;
    }
    .btn-cancel:hover { background: #f1f5f9; border-color: #94a3b8; }
    .btn-cancel:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-create {
        height: 44px;
        padding: 0 28px;
        border: none;
        border-radius: 8px;
        background: #3b82f6;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Poppins', sans-serif;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background 0.2s, box-shadow 0.2s;
    }
    .btn-create:hover {
        background: #2563eb;
        box-shadow: 0 4px 6px -1px rgba(59,130,246,0.3);
    }
    .btn-create:disabled { opacity: 0.7; cursor: not-allowed; }

    @@media (max-width: 768px) {
        .form-row { grid-template-columns: 1fr; }
        .form-popup-footer { flex-direction: column; }
        .btn-cancel, .btn-create { width: 100%; justify-content: center; }
    }
</style>