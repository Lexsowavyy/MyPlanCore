<script>
    function step(direction, inputId, minValue) {
        const input = document.getElementById(inputId);
        let val = parseInt(input.value, 10);
        if (isNaN(val)) val = minValue;
        val = direction ? val + 1 : val - 1;
        if (val < minValue) val = minValue;
        input.value = val;
    }

    function addTag(selId, qtyId, unitId, hiddenId, tagContainerId) {
        const sel = document.getElementById(selId);
        if (!sel.value) return;
        const qty = document.getElementById(qtyId);
        const unit = document.getElementById(unitId);
        const hidden = document.getElementById(hiddenId);
        const line = sel.value + ' (' + qty.value + ' ' + unit.value + ')';
        hidden.value = hidden.value ? hidden.value + '\n' + line : line;
        sel.value = '';
        qty.value = '1';
        renderTags(hiddenId, tagContainerId);
    }

    function renderTags(hiddenId, tagContainerId) {
        const hidden = document.getElementById(hiddenId);
        const container = document.getElementById(tagContainerId);
        container.innerHTML = '';
        const lines = hidden.value.split('\n').filter(function (l) { return l.trim(); });
        lines.forEach(function (line) {
            const tag = document.createElement('div');
            tag.className = 'tag-item';
            const span = document.createElement('span');
            span.textContent = line;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'tag-remove';
            btn.textContent = '\u00d7';
            btn.onclick = function () {
                const remaining = hidden.value.split('\n').filter(function (l) { return l.trim() && l !== line; });
                hidden.value = remaining.join('\n');
                renderTags(hiddenId, tagContainerId);
            };
            tag.appendChild(span);
            tag.appendChild(btn);
            container.appendChild(tag);
        });
    }

    function stepperManpower(delta) {
        const hidden = document.getElementById('manpower');
        const display = document.getElementById('manpower-display');
        let val = parseInt(hidden.value, 10);
        if (isNaN(val)) val = 0;
        val += delta;
        if (val < 0) val = 0;
        hidden.value = val;
        display.textContent = val;
    }

    function stepperEditManpower(delta) {
        const hidden = document.getElementById('edit-manpower');
        const display = document.getElementById('edit-manpower-display');
        let val = parseInt(hidden.value, 10);
        if (isNaN(val)) val = 0;
        val += delta;
        if (val < 0) val = 0;
        hidden.value = val;
        display.textContent = val;
    }
</script>

@functions {
    List<string> GetMaterials(string? json)
    {
        if (string.IsNullOrEmpty(json)) return new();
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch
        {
            try { var single = JsonSerializer.Deserialize<string>(json); return single != null ? new() { single } : new(); }
            catch { return new(); }
        }
    }
    List<string> GetEquipment(string? json)
    {
        if (string.IsNullOrEmpty(json)) return new();
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch
        {
            try { var single = JsonSerializer.Deserialize<string>(json); return single != null ? new() { single } : new(); }
            catch { return new(); }
        }
    }

    string StatusBadge(string status) => status switch
    {
        "Approved" => "badge-green",
        "Rejected" => "badge-red",
        "Fulfilled" => "badge-teal",
        _ => "badge-yellow"
    };
}