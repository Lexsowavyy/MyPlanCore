                <h3><i class="fas fa-pencil-ruler" style="color:#f59e0b;"></i> Revision Details</h3>
                <a type="button" class="modal-close" href="/architect/archived?tab=@Model.ActiveTab"><i class="fas fa-times"></i></a>
            </div>
            <div class="modal-body">
                <div class="detail-row"><span class="detail-label">Request</span><span class="detail-value">@selectedRevision.ChangeRequest</span></div>
