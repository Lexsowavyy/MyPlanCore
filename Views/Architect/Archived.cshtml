                <div class="detail-row"><span class="detail-label">PM Notes</span><span class="detail-value" style="white-space:pre-wrap;">@selectedRevision.RevisionNotes</span></div>
                <div class="detail-row"><span class="detail-label">Requested By</span><span class="detail-value">@selectedRevision.RequestedBy</span></div>
                <div class="detail-row"><span class="detail-label">Date</span><span class="detail-value">@(selectedRevision.RequestDate.ToString("MMM d, yyyy h:mm tt"))</span></div>
                <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">@selectedRevision.Status</span></div>
