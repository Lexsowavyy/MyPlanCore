@model PlanCore.Web.ViewModels.ArchitectArchivedViewModel
@functions {
    public string GetDesignImageSrc(PlanCoreMAUI.Models.ArchitectDesign? design)
    {
        if (design?.FileData == null || design.FileData.Length == 0) return "";
        var base64 = Convert.ToBase64String(design.FileData);
        var mime = design.FileName?.EndsWith(".png") == true ? "image/png" : "image/jpeg";
        return $"data:{mime};base64,{base64}";
    }

    public DateTime? GetDesignReviewTimestamp(PlanCoreMAUI.Models.ArchitectDesign? d) => d?.Status switch
    {
        "Approved" or "Accepted" => d.ApprovedOn,
        "Rejected" => d.RejectedOn,
        "Revised" => d.RevisedOn,
        _ => null
    };
}
<div class="page-container">
    <div class="page-header">
        <h2 class="page-title"><i class="fas fa-archive"></i> Archived Module</h2>
        <p class="page-subtitle">Restore or view archived items</p>
    </div>

    <div class="filter-bar" style="margin-bottom:16px;">
        <div class="archive-tabs">
            <a class="archive-tab-btn @(Model.ActiveTab == "designs" ? "active" : "")" href="/architect/archived?tab=designs">
                Archived Designs
            </a>
            <a class="archive-tab-btn @(Model.ActiveTab == "revisions" ? "active" : "")" href="/architect/archived?tab=revisions">
                Archived Revisions
            </a>
            <a class="archive-tab-btn @(Model.ActiveTab == "tasks" ? "active" : "")" href="/architect/archived?tab=tasks">
                Archived Tasks
            </a>
        </div>
    </div>

    @if (Model.ActiveTab == "designs")
    {
        <div class="table-section">
            <div class="table-header">
                <span><i class="fas fa-drafting-compass"></i> Archived Designs</span>
                <span class="item-count">@Model.ArchivedDesigns.Count items</span>
            </div>
            <div class="table-scroll">
                <table class="project-table">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Design</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Date & Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ArchivedDesigns.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">No archived designs</td></tr>
                        }
                        else
                        {
                            foreach (var d in Model.ArchivedDesigns)
                            {
                                <tr>
                                    <td><span class="id-cell">DSN-@(d.DesignID.ToString("D4"))</span></td>
                                    <td><span class="project-cell">@d.DesignTitle</span></td>
                                    <td>@d.Project</td>
                                    <td><span class="badge">@d.Status</span></td>
                                    <td>@(d.ArchivedOn?.ToString("MMM d, yyyy h:mm tt"))</td>
                                    <td>
                                        <a class="icon-btn" title="View" href="/architect/archived?tab=@Model.ActiveTab&viewType=design&viewId=@d.DesignID"><i class="fas fa-eye"></i></a>
                                        <a class="icon-btn" title="Restore" href="/architect/archived?tab=@Model.ActiveTab&restoreType=design&restoreId=@d.DesignID"><i class="fas fa-undo"></i></a>
                                        <a class="icon-btn" title="Delete" href="/architect/archived?tab=@Model.ActiveTab&deleteType=design&deleteId=@d.DesignID"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.ActiveTab == "revisions")
    {
        <div class="table-section">
            <div class="table-header">
                <span><i class="fas fa-pencil-ruler"></i> Archived Revisions</span>
                <span class="item-count">@Model.ArchivedRevisions.Count items</span>
            </div>
            <div class="table-scroll">
                <table class="project-table">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Request</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Date & Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ArchivedRevisions.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">No archived revisions</td></tr>
                        }
                        else
                        {
                            foreach (var r in Model.ArchivedRevisions)
                            {
                                <tr>
                                    <td><span class="id-cell">REV-@(r.RevisionID.ToString("D4"))</span></td>
                                    <td><span class="project-cell">@r.ChangeRequest</span></td>
                                    <td>@r.Project</td>
                                    <td><span class="badge">@r.Status</span></td>
                                    <td>@(r.ArchivedOn?.ToString("MMM d, yyyy h:mm tt"))</td>
                                    <td>
                                        <a class="icon-btn" title="View" href="/architect/archived?tab=@Model.ActiveTab&viewType=revision&viewId=@r.RevisionID"><i class="fas fa-eye"></i></a>
                                        <a class="icon-btn" title="Restore" href="/architect/archived?tab=@Model.ActiveTab&restoreType=revision&restoreId=@r.RevisionID"><i class="fas fa-undo"></i></a>
                                        <a class="icon-btn" title="Delete" href="/architect/archived?tab=@Model.ActiveTab&deleteType=revision&deleteId=@r.RevisionID"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.ActiveTab == "tasks")
    {
        <div class="table-section">
            <div class="table-header">
                <span><i class="fas fa-tasks"></i> Archived Tasks</span>
                <span class="item-count">@Model.ArchivedTasks.Count items</span>
            </div>
            <div class="table-scroll">
                <table class="project-table">
                    <thead>
                        <tr>
                            <th>#ID</th>
                            <th>Task</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Date & Time</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ArchivedTasks.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">No archived tasks</td></tr>
                        }
                        else
                        {
                            foreach (var t in Model.ArchivedTasks)
                            {
                                <tr>
                                    <td><span class="id-cell">TSK-@(t.Id.ToString("D4"))</span></td>
                                    <td><span class="project-cell">@t.Name</span></td>
                                    <td>@t.Project</td>
                                    <td><span class="badge">@t.Status</span></td>
                                    <td>@(t.ArchivedOn?.ToString("MMM d, yyyy h:mm tt"))</td>
                                    <td>
                                        <a class="icon-btn" title="View" href="/architect/archived?tab=@Model.ActiveTab&viewType=task&viewId=@t.Id"><i class="fas fa-eye"></i></a>
                                        <a class="icon-btn" title="Restore" href="/architect/archived?tab=@Model.ActiveTab&restoreType=task&restoreId=@t.Id"><i class="fas fa-undo"></i></a>
                                        <a class="icon-btn" title="Delete" href="/architect/archived?tab=@Model.ActiveTab&deleteType=task&deleteId=@t.Id"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (Model.ShowViewModal && Model.ActiveTab == "designs" && Model.SelectedDesign != null)
{
    var selectedDesign = Model.SelectedDesign;
    <div class="modal-overlay" onclick="window.location.href='/architect/archived?tab=@Model.ActiveTab'">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3><i class="fas fa-drafting-compass" style="color:#8b5cf6;"></i> Design Details</h3>
                <a type="button" class="modal-close" href="/architect/archived?tab=@Model.ActiveTab"><i class="fas fa-times"></i></a>
            </div>
            <div class="modal-body">
                <div class="detail-row"><span class="detail-label">Design</span><span class="detail-value">@selectedDesign.DesignTitle</span></div>
                <div class="detail-row"><span class="detail-label">Project</span><span class="detail-value">@selectedDesign.Project</span></div>
                <div class="detail-row"><span class="detail-label">Location</span><span class="detail-value">@selectedDesign.Location</span></div>
                <div class="detail-row"><span class="detail-label">Version</span><span class="detail-value">@selectedDesign.Version</span></div>
                <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">@selectedDesign.Status</span></div>
                @{
                    var dts = GetDesignReviewTimestamp(selectedDesign);
                    if (dts.HasValue)
                    {
                        <div class="detail-row"><span class="detail-label">Reviewed On</span><span class="detail-value">@(dts.Value.ToString("MMM d, yyyy h:mm tt"))</span></div>
                    }
                }
                <div class="detail-row"><span class="detail-label">Uploaded</span><span class="detail-value">@(selectedDesign.UploadDate.ToString("MMM d, yyyy h:mm tt"))</span></div>
                <div class="detail-row"><span class="detail-label">Archived</span><span class="detail-value">@(selectedDesign.ArchivedOn?.ToString("MMM d, yyyy h:mm tt"))</span></div>
                <div class="detail-row"><span class="detail-label">Notes</span><span class="detail-value">@selectedDesign.Notes</span></div>
                @if (selectedDesign.FileData != null && selectedDesign.FileData.Length > 0)
                {
                    <div class="detail-row">
                        <span class="detail-label">Image</span>
                        <span class="detail-value"><img src="@(GetDesignImageSrc(selectedDesign))" style="max-width:200px;max-height:200px;border-radius:8px;" /></span>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <a class="btn-cancel" href="/architect/archived?tab=@Model.ActiveTab" style="text-decoration:none;display:inline-flex;align-items:center;">Close</a>
            </div>
        </div>
    </div>
}

@if (Model.ShowViewModal && Model.ActiveTab == "revisions" && Model.SelectedRevision != null)
