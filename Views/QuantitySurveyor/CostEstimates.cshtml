@functions {
    string GetStatusClass(string? status)
    {
        return status switch
        {
            "Approved" => "badge-green",
            "Rejected" => "badge-red",
            "Waiting for PM Approval" => "badge-teal",
            "Pending Approval" => "badge-orange",
            _ => "badge-blue"
        };
    }
}
