@functions {
    string GetApprovalStatusClass(string? status)
    {
        return status switch
        {
            "Approved" => "badge-green",
            "Rejected" => "badge-red",
            "Waiting for PM Approval" => "badge-teal",
            "Pending Approval" => "badge-orange",
            _ => "badge-blue"
        };
    }

    string GetHealthStatusClass(string? health)
    {
        return health switch
        {
            "On Track" => "badge-green",
            "Warning" => "badge-orange",
            "Critical" => "badge-teal",
            "Over Budget" => "badge-red",
            _ => "badge-blue"
        };
    }

    string GetRemainingColor(PlanCoreMAUI.Models.QS_Budget? b)
    {
        if (b == null) return "#475569";
        if (b.Remaining < 0) return "#dc2626";
        var ratio = b.TotalBudget > 0 ? b.TotalSpent / b.TotalBudget : 0;
        if (ratio >= 0.9m) return "#d97706";
        return "#16a34a";
    }
}
