@model PlanCore.Web.ViewModels.ChangePasswordViewModel
@{
    Layout = "_BareLayout";
    var goToDashboard = (string)(ViewData["DashboardUrl"] ?? "/");
}
<div style="display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; box-sizing: border-box; font-family: 'Poppins', sans-serif;">
    <div style="background: #ffffff; border-radius: 24px; padding: 52px 72px; width: 100%; max-width: 960px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); text-align: center;">
        <div style="text-align: center; margin-bottom: 28px;">
            <img src="~/images/logo.png" alt="PlanCore Logo" style="width: 140px; height: auto;" />
        </div>

        <h2 style="margin: 0 0 4px; font-size: 1.25rem; color: #1e293b; text-align: center;">Change Password</h2>
        <p style="margin: 0 0 24px; font-size: 0.8rem; color: #94a3b8; text-align: center;">Update your account password</p>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div style="background: #dcfce7; border: 1px solid #bbf7d0; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #166534; font-size: 0.75rem; text-align: center;">
                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> @Model.SuccessMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; padding: 10px 14px; margin-bottom: 12px; color: #dc2626; font-size: 0.75rem;">@Model.ErrorMessage</div>
        }

        @if (!Model.PasswordChanged)
        {
            <form method="post" action="/Account/ChangePassword">
                <div style="margin-bottom: 14px; text-align: left;">
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                        <i class="fas fa-lock" style="color: #0f172a; margin-right: 5px;"></i> Current Password
                    </label>
                    <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; transition: all 0.3s; background: #f8fafc;">
                        <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                            <i class="fas fa-key" style="font-size: 0.82rem;"></i>
                        </span>
                        <input type="password" name="currentPassword" style="border: none; padding: 11px 10px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif;" placeholder="Enter current password" />
                    </div>
                </div>

                <div style="margin-bottom: 14px; text-align: left;">
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                        <i class="fas fa-key" style="color: #0f172a; margin-right: 5px;"></i> New Password
                    </label>
                    <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; transition: all 0.3s; background: #f8fafc;">
                        <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                            <i class="fas fa-key" style="font-size: 0.82rem;"></i>
                        </span>
                        <input type="password" name="newPassword" style="border: none; padding: 11px 10px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif;" placeholder="Enter your new password" />
                    </div>
                    <div style="font-size: 0.65rem; color: #94a3b8; margin-top: 4px;">8-12 characters with uppercase, lowercase, digit &amp; special character.</div>
                </div>

                <div style="margin-bottom: 24px; text-align: left;">
                    <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 6px;">
                        <i class="fas fa-check-circle" style="color: #0f172a; margin-right: 5px;"></i> Confirm New Password
                    </label>
                    <div style="position: relative; display: flex; border-radius: 10px; overflow: hidden; border: 1.5px solid #0f172a; transition: all 0.3s; background: #f8fafc;">
                        <span style="background: transparent; border: none; border-right: 1.5px solid #cbd5e1; padding: 0 12px; color: #475569; display: flex; align-items: center;">
                            <i class="fas fa-check" style="font-size: 0.82rem;"></i>
                        </span>
                        <input type="password" name="confirmPassword" style="border: none; padding: 11px 10px; font-size: 0.82rem; flex: 1; background: transparent; color: #1e293b; font-family: 'Poppins', sans-serif;" placeholder="Re-enter new password" />
                    </div>
                </div>

                <button type="submit" style="width: 100%; padding: 11px; font-size: 0.85rem; font-weight: 600; color: #ffffff; background: linear-gradient(135deg, #0f172a 0%, #0f2456 50%, #1e3a6e 100%); border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 20px rgba(15,23,42,0.45); display: flex; align-items: center; justify-content: center; gap: 8px;">
                    <i class="fas fa-save"></i>
                    Update Password
                </button>

                <div style="margin-top: 14px; padding-top: 14px; border-top: 1px solid #f1f5f9; text-align: center;">
                    <a href="@goToDashboard" style="color: #0f172a; text-decoration: none; font-size: 0.75rem; font-weight: 500;">
                        <i class="fas fa-arrow-left" style="margin-right: 4px;"></i> Back to Dashboard
                    </a>
                </div>
            </form>
        }
        else
        {
            <a href="@goToDashboard" style="display: block; width: 100%; padding: 11px; font-size: 0.85rem; font-weight: 600; color: #ffffff; background: linear-gradient(135deg, #0f172a 0%, #0f2456 50%, #1e3a6e 100%); border: none; border-radius: 10px; cursor: pointer; box-shadow: 0 4px 20px rgba(15,23,42,0.45); text-decoration: none; box-sizing: border-box;">
                <i class="fas fa-tachometer-alt" style="margin-right: 6px;"></i> Back to Dashboard
            </a>

            <form method="post" action="/Account/SignOut" style="margin-top: 14px; padding-top: 14px; border-top: 1px solid #f1f5f9; text-align: center;">
                <button type="submit" style="background: none; border: none; color: #dc2626; font-size: 0.75rem; font-weight: 500; cursor: pointer; font-family: 'Poppins', sans-serif;">
                    <i class="fas fa-sign-out-alt" style="margin-right: 4px;"></i> Sign out and log in again
                </button>
            </form>
        }
    </div>
</div>